{
  "mcpServers": {
    "google-ads": {
      "command": "pipx",
      "args": ["run", "--spec", "git+https://github.com/googleads/google-ads-mcp.git", "google-ads-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "RUTA_AL_ARCHIVO_DE_CREDENCIALES_JSON",
        "GOOGLE_CLOUD_PROJECT": "ID_DEL_PROYECTO_DE_GOOGLE_CLOUD",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "NUMERO_DE_LA_CUENTA_DE_ADMINISTRADOR_SIN_GUIONES",
        "GOOGLE_ADS_MCP_TOOLS_CONFIG": "RUTA_A/mcp-google-ads/tools_config.yaml"
      }
    }
  }
}
