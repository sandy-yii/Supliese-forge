# Variables del puente páginas → Go High Level. Van en Vercel › Settings › Environment Variables de CADA sitio.
# Solo NEXT_PUBLIC_PREFIJO_FOLIO es pública. Todo lo demás es secreto de servidor: nunca con NEXT_PUBLIC_.

# Dos letras por marca: QL Quick Laundry · KS Kingstar · LS Laundry Solutions · GB Girbau · GS Gamesail
NEXT_PUBLIC_PREFIJO_FOLIO=QL

# Go High Level › subcuenta de ESTA marca › Settings › Private Integrations › nuevo token
# Permisos: contacts.write y contacts.readonly. Nada más.
GHL_TOKEN=
GHL_LOCATION_ID=

# IDs de los campos personalizados del contacto (Settings › Custom Fields), en una sola línea.
GHL_CAMPOS={"gclid":"","gbraid":"","wbraid":"","utm_campaign":"","utm_term":"","pagina":"","fecha":"","folio":""}

# Secreto que manda la automatización de WhatsApp en el encabezado x-puente-secreto. 32+ caracteres al azar:
#   openssl rand -hex 24
GHL_WEBHOOK_SECRETO=

# Almacén de folios: Vercel › Storage › Marketplace › Upstash (Redis). Vercel llena estas dos solo.
# Puede ser uno para los 5 sitios: los folios llevan el prefijo de la marca.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Solo en vistas previas: etiqueta para reconocer y borrar los contactos de prueba en Go High Level.
PUENTE_ETIQUETA_PRUEBA=
